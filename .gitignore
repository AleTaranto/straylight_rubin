# --- secrets -----------------------------------------------------------------
# .env holds CONSDB_TOKEN plus PGUSER and pointers to PGPASSFILE /
# AWS_SHARED_CREDENTIALS_FILE. It is regenerable: python common/create_dot_env.py
.env
*.env
!*.env.example

# --- data and outputs --------------------------------------------------------
# ~1.3 GB of inputs and generated products. Keeping these out is what makes the
# repo ~40 MB instead of 1.5 GB. Nothing here is deleted - it is just untracked.
data/
outputs/
L3_baffle/rubin_one_year_output/

# --- Jupyter / Python scratch ------------------------------------------------
.ipynb_checkpoints/
**/.ipynb_checkpoints/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# --- editor / OS -------------------------------------------------------------
*~
*.swp
*.bak
*.orig
*.original_bak
.DS_Store
.vscode/

# --- Slurm / batch logs ------------------------------------------------------
jobs/stdout/
*.out
*.err
slurm-*.out

# --- large artifacts that should never be committed --------------------------
*.fits
!L3_baffle/ybsc_v5.fits
*.bsp
*.db
*.parquet
*.npz
*.csv
*.gif
*.png
*.jpg
*.jpeg
# ...but keep small documentation images if any are ever added:
!docs/**/*.png

# --- generated Zemax macros --------------------------------------------------
# Written per-visit by zemax_geometry/sky_geometry*.ipynb; regenerable.
*.zpl
*.ZPL

# --- LaTeX report build artifacts -------------------------------------------
# The .tex sources are generated by zemax_geometry/build_report.py and the
# figures by report_figures.py, so nothing under report/ needs tracking: run
# `python build_report.py && latexmk -pdf` to rebuild it all from evidence.pkl.
zemax_geometry/report/
*.aux
*.fls
*.fdb_latexmk
*.synctex.gz
*.toc
*.log
